# Configuración del Chatbot de Phasmophobia - Plantilla

# URL del webhook (REQUERIDA)
WEBHOOK_URL=https://tu-webhook-url.com/webhook/chatbot

# Timeout para las peticiones HTTP en milisegundos (opcional)
CHAT_TIMEOUT=30000

# Longitud máxima de mensaje permitida (opcional)
MAX_MESSAGE_LENGTH=500

# Instrucciones:
# 1. Copia este archivo como .env
# 2. Reemplaza los valores con tu configuración real
# 3. El archivo .env será ignorado por git por seguridad